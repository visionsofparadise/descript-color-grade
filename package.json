{
	"name": "descript-color-grade",
	"productName": "Descript Color Grade",
	"version": "1.1.2",
	"description": "Bit-exact Descript color grade preview for podcast grading",
	"main": ".vite/build/main.js",
	"private": true,
	"scripts": {
		"start": "rimraf ./node_modules/.vite && electron-forge start",
		"package": "electron-forge package",
		"make": "electron-forge make",
		"publish": "electron-forge publish",
		"prepare": "node -e \"import('node:child_process').then(({execSync})=>{try{execSync('git rev-parse --is-inside-work-tree',{stdio:'ignore'});execSync('git config core.hooksPath .githooks')}catch{}})\" && node tools.mjs install",
		"fix": "concurrently -m 1 --group \"prettier --write .\" \"eslint . --fix --cache\" \"stylelint \\\"**/*.css\\\" --fix --allow-empty-input --cache\" \"markdownlint-cli2 --fix \\\"**/*.md\\\"\" \"textlint --fix \\\"**/*.md\\\"\"",
		"check": "concurrently --group \"prettier --check .\" \"eslint . --no-cache -f unix\" \"tsc --noEmit --pretty false\" \"stylelint \\\"**/*.css\\\" -f unix --allow-empty-input --cache\" \"markdownlint-cli2 \\\"**/*.md\\\"\" \"textlint -f compact \\\"**/*.md\\\"\" \"knip --no-progress\" \"jscpd .\" \"node tools.mjs run actionlint\"",
		"unit": "vitest run"
	},
	"keywords": [],
	"author": {
		"name": "visionsofparadise",
		"email": "matt@mattcavender.com"
	},
	"license": "MIT",
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@electron-forge/cli": "^7.11.1",
		"@electron-forge/maker-deb": "^7.11.1",
		"@electron-forge/maker-rpm": "^7.11.1",
		"@electron-forge/maker-squirrel": "^7.11.1",
		"@electron-forge/maker-zip": "^7.11.1",
		"@electron-forge/plugin-fuses": "^7.11.1",
		"@electron-forge/plugin-vite": "^7.11.1",
		"@electron/fuses": "^1.8.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^9.39.4",
		"@html-eslint/eslint-plugin": "^0.65.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tailwindcss/postcss": "^4.2.2",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^4.7.0",
		"@vitest/browser-playwright": "^4.1.4",
		"autoprefixer": "^10.4.27",
		"concurrently": "^9.2.1",
		"electron": "41.2.0",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-formatter-unix": "^9.0.1",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-barrel-files": "^3.0.1",
		"eslint-plugin-comment-rules": "^0.1.7",
		"eslint-plugin-import-x": "^4.16.2",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"globals": "^17.4.0",
		"jscpd": "^5.1.2",
		"knip": "^6.34.0",
		"markdownlint-cli2": "^0.23.2",
		"playwright": "^1.59.1",
		"postcss": "^8.5.9",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"stylelint": "^17.15.0",
		"stylelint-config-recommended": "^18.0.0",
		"textlint": "^15.8.0",
		"textlint-filter-rule-comments": "^1.3.0",
		"textlint-rule-no-dead-link": "^6.2.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.58.1",
		"vite": "^5.4.21",
		"vitest": "^4.1.4"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"electron-squirrel-startup": "^1.0.1",
		"lucide-react": "^1.8.0",
		"opshot": "^0.6.0",
		"pathe": "^2.0.3",
		"radix-ui": "^1.4.3",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.2"
	},
	"allowScripts": {
		"electron@41.2.0": true,
		"electron-winstaller@5.4.0": true,
		"esbuild@0.21.5": true,
		"unrs-resolver@1.11.1": true
	}
}
