{
  "name": "descript-color-grade",
  "productName": "Descript Color Grade",
  "version": "1.1.2",
  "description": "Bit-exact Descript color grade preview for podcast grading",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "rimraf ./node_modules/.vite && electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "check": "concurrently \"eslint . --fix --cache --format ./agent-eslint.mjs\" \"tsc --noEmit --pretty false 2>&1 | node ./agent-tsc.mjs\"",
    "check:verbose": "concurrently \"eslint . --cache\" \"tsc --noEmit\"",
    "lint": "eslint . --fix --cache --format ./agent-eslint.mjs",
    "lint:verbose": "eslint .",
    "lint:fix": "eslint . --fix",
    "unit": "vitest run"
  },
  "keywords": [],
  "author": {
    "name": "visionsofparadise",
    "email": "matt@mattcavender.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^4.1.4",
    "@vitest/browser-playwright": "^4.1.4",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "41.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-barrel-files": "^3.0.1",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.9",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^5.4.21",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.8.0",
    "pathe": "^2.0.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "valtio": "^2.3.1"
  }
}
